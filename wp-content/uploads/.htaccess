# Block direct execution of PHP and executable scripts in uploads directory
<FilesMatch "(?i)\.(php|php3|php4|php5|php7|phtml|phps|pl|py|cgi|sh|bash|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>
